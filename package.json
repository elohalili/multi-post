{
  "name": "Multi-Post",
  "version": "1.0.0",
  "description": "Standalone desktop app to pre-fill Facebook group posts (caption + photos). Never auto-posts.",
  "main": "electron/main.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "dist": "npm run build:renderer && electron-builder -mw",
    "dist:mac": "npm run build:renderer && electron-builder -m",
    "dist:mac-arm64": "npm run build:renderer && electron-builder -m --arm64",
    "dist:mac-x64": "npm run build:renderer && electron-builder -m --x64",
    "dist:win": "npm run build:renderer && electron-builder -w"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.0"
  },
  "build": {
    "appId": "com.multipost.app",
    "productName": "Multi-Post",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "!renderer/**/*.jsx"
    ],
    "mac": {
      "icon": "icon.svg.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.social-networking"
    },
    "win": {
      "icon": "icon.svg.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
